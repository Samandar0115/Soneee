{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/((?!sw\\.js|manifest\\.webmanifest|favicon\\.svg|assets/.*).*)", "destination": "/index.html" }
  ]
}
